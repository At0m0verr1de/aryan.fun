// Cloudflare Workers deploy config. Static files from `npm run build` are served first;
// worker/index.js only handles /api/events (telemetry → Workers Logs) and unmatched paths.
// Live at https://madebyaryan.aryanbakshi2021.workers.dev; each upload also gets a preview URL.
{
  "name": "madebyaryan",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "preview_urls": true,
  "assets": { "directory": "./dist", "binding": "ASSETS" },
  // Free tier: 200k log events/day. Per-request invocation logs are off so only our own events count.
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": { "invocation_logs": false }
  }
}
