---
import Layout from '../shared/Layout.astro';
import { meta } from '../toys/chess-mates/meta';
---
<Layout title={`${meta.title} · made by aryan`} description={meta.blurb} crumb={meta.title}>
  <div id="gate"><div class="card center gate-card"><span class="gate-icon spin" aria-hidden="true">♞&#xFE0E;</span>Setting up the board…</div></div>

  <div id="chess-view" hidden>
    <header class="cm-head">
      <h1>Chess Mates <span class="heart beat" aria-hidden="true">♥</span></h1>
    </header>

    <section id="chess-setup" hidden></section>

    <div id="chess-main" hidden>
      <div class="sync-bar" id="sync-bar"></div>
      <section class="rivalry card" id="rivalry"></section>
      <nav class="chips" id="filters" aria-label="Time control"></nav>
      <section class="last-game card" id="last-game" hidden></section>
      <div class="stats" id="stats"></div>
      <section class="history" id="history"></section>
      <p class="fine muted">Games come from chess.com's public data, checked every few hours and whenever you open this page. Not affiliated with Chess.com.</p>
    </div>
  </div>
  <div class="toast" id="chess-toast" role="status"></div>
</Layout>

<script>
  import '../toys/chess-mates/app.js';
</script>

<style is:global>
  .muted { color: var(--muted); }
  .small { font-size: .84rem; }
  .center { text-align: center; }
  .narrow { max-width: 460px; margin: 0 auto; }
  #gate .card { display: flex; flex-direction: column; gap: 12px; align-items: center; }
  #gate h2, #gate p { margin: 0; }
  #gate .btn { text-decoration: none; }
  .gate-icon { font-size: 2.4rem; }
  .gate-icon.spin { animation: hop 1.1s ease-in-out infinite; }
  @keyframes hop { 30% { transform: translate(6px, -12px) rotate(10deg); } 60% { transform: translate(12px, 0); } }

  #chess-view { --me: var(--blue); --them: var(--pink); --sq-light: #f7e9ef; --sq-dark: #c98da9; display: grid; gap: 16px; }
  .cm-head { text-align: center; }
  .cm-head h1 { margin: 0; font-size: clamp(2rem, 6vw, 2.8rem); }
  .cm-head h1 .heart { font-size: .6em; vertical-align: .2em; }
  #chess-main { display: grid; gap: 16px; }
  #chess-main[hidden], #chess-setup[hidden] { display: none; }

  /* ---------- setup ---------- */
  .setup-card { max-width: 460px; margin: 0 auto; text-align: center; display: grid; gap: 12px; background: var(--surface);
    border: 1px solid var(--line); border-radius: 24px; padding: 26px 22px; }
  .setup-card h2, .setup-card p { margin: 0; }
  .kings { display: flex; justify-content: center; align-items: flex-end; gap: 14px; font-size: 3.4rem; line-height: 1; }
  .kings .k.white { color: #fffaf3; text-shadow: 0 0 1px #2b1a24, 0 2px 0 #2b1a24; animation: lean-r 2.6s ease-in-out infinite; }
  .kings .k.black { color: #2b1a24; text-shadow: 0 0 1px #fffaf3, 0 2px 0 rgba(255, 255, 255, .5); transform: scaleX(-1); animation: lean-l 2.6s ease-in-out infinite; }
  .kings .love { color: var(--heart); font-size: 1.4rem; margin-bottom: 1.4rem; animation: heartbeat 1.6s ease-in-out infinite; }
  @keyframes lean-r { 50% { transform: rotate(8deg); } }
  @keyframes lean-l { 50% { transform: scaleX(-1) rotate(8deg); } }
  .names-form { display: grid; gap: 12px; text-align: left; margin-top: 4px; }
  .names-form label { display: grid; gap: 6px; font-weight: 800; font-size: .92rem; }
  .names-form input:invalid:not(:placeholder-shown):not(:focus) { border-color: var(--danger); }
  .form-error { margin: 0; color: var(--danger); font-weight: 700; min-height: 1.2em; font-size: .9rem; }
  .setup-actions { display: flex; gap: 8px; justify-content: center; }
  .setup-actions .btn { padding: 11px 18px; font-size: 1rem; }

  /* ---------- sync bar ---------- */
  .sync-bar { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 8px 14px; font-weight: 700; font-size: .9rem; }
  .sync-status { display: inline-flex; align-items: center; gap: 8px; color: var(--muted); }
  .sync-status.bad { color: var(--danger); }
  .sync-actions { display: inline-flex; align-items: center; gap: 14px; }
  .btn.small { padding: 7px 12px; font-size: .86rem; }
  .spinner { width: 13px; height: 13px; border-radius: 50%; border: 2px solid var(--line); border-top-color: var(--lilac); animation: spin .8s linear infinite; }
  @keyframes spin { to { transform: rotate(360deg); } }

  /* ---------- rivalry ---------- */
  .rivalry { display: grid; gap: 6px; padding: 20px 18px 16px; overflow: hidden; position: relative; }
  .score { display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; gap: 8px; }
  .side { display: grid; justify-items: center; gap: 2px; position: relative; }
  .side .face { font-size: 2.2rem; line-height: 1; }
  .side .who { font-weight: 800; color: var(--muted); font-size: .92rem; max-width: 100%; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .side .wins { font-family: Fredoka, Nunito, sans-serif; font-size: clamp(2.6rem, 11vw, 3.8rem); font-weight: 700; line-height: 1; font-variant-numeric: tabular-nums; }
  .score .side:first-child .wins { color: var(--me); }
  .score .side:last-child .wins { color: var(--them); }
  .side .crown { position: absolute; top: -14px; font-size: 1.1rem; animation: crown 2.4s ease-in-out infinite; }
  @keyframes crown { 50% { transform: translateY(-3px) rotate(-8deg); } }
  .mid { display: grid; justify-items: center; gap: 2px; font-weight: 700; color: var(--muted); font-size: .84rem; }
  .mid .vs { font-family: Fredoka, Nunito, sans-serif; font-size: 1.3rem; color: var(--faint); }
  .rope { width: 100%; height: 40px; overflow: visible; }
  .rope .mark { stroke: var(--faint); stroke-width: 2; stroke-dasharray: 3 4; }
  .rope-line { fill: none; stroke: color-mix(in srgb, var(--gold) 70%, #8a5a2b); stroke-width: 5; stroke-linecap: round; }
  .knot { transform: translateX(0); animation: tug 1.1s cubic-bezier(.3, 1.4, .5, 1) .25s forwards; }
  .knot circle { fill: var(--heart); stroke: #fff; stroke-width: 2.5; }
  .knot path { stroke: var(--heart); stroke-width: 3; stroke-linecap: round; fill: none; }
  @keyframes tug { to { transform: translateX(var(--x)); } }
  .streak { margin: 0; text-align: center; font-weight: 800; }

  /* ---------- filters ---------- */
  .chips { display: flex; flex-wrap: wrap; gap: 6px; justify-content: center; }
  .chips:empty { display: none; }
  .chip { border: 1px solid var(--line); background: var(--surface-2); border-radius: 999px; padding: 6px 12px; cursor: pointer; font-weight: 800; font-size: .86rem; transition: background .2s, border-color .2s; }
  .chip.on { border-color: var(--heart); background: color-mix(in srgb, var(--heart) 22%, var(--surface-2)); }

  /* ---------- last game ---------- */
  .last-game { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr); gap: 20px; align-items: center; }
  .last-game[hidden] { display: none; }
  .board { display: grid; grid-template-columns: repeat(8, 1fr); aspect-ratio: 1; border-radius: 12px; overflow: hidden;
    box-shadow: 0 0 0 4px color-mix(in srgb, var(--sq-dark) 55%, var(--surface)), 0 14px 30px rgba(0, 0, 0, .35); }
  .sq { display: grid; place-items: center; position: relative; container-type: inline-size; }
  .sq.l { background: var(--sq-light); }
  .sq.d { background: var(--sq-dark); }
  .pc { font-size: 82cqw; line-height: 1; font-family: 'Segoe UI Symbol', 'Noto Sans Symbols 2', 'DejaVu Sans', serif; user-select: none;
    animation: drop .35s ease-out backwards; animation-delay: calc(var(--i) * 6ms); }
  .pc.w { color: #fffaf3; -webkit-text-stroke: 1.2px #3a2530; text-shadow: 0 2px 2px rgba(0, 0, 0, .25); }
  .pc.b { color: #2b1a24; text-shadow: 0 2px 2px rgba(0, 0, 0, .2); }
  @keyframes drop { from { opacity: 0; transform: translateY(-30%) scale(.8); } }
  .files { display: grid; grid-template-columns: repeat(8, 1fr); margin-top: 8px; }
  .files i { font-style: normal; text-align: center; font-size: .72rem; font-weight: 800; color: var(--faint); }
  .last-info { display: grid; gap: 8px; align-content: start; }
  .last-info p { margin: 0; }
  .eyebrow { font-size: .76rem; font-weight: 800; letter-spacing: .08em; text-transform: uppercase; color: var(--faint); }
  .headline { margin: 0; font-size: clamp(1.4rem, 4.4vw, 1.9rem); line-height: 1.15; animation: pop .5s cubic-bezier(.3, 1.6, .5, 1) backwards; }
  .headline.win { color: var(--me); }
  .headline.loss { color: var(--them); }
  @keyframes pop { from { transform: scale(.8); opacity: 0; } }
  .meta { font-weight: 700; color: var(--muted); }
  .opening { font-weight: 700; }
  .players { display: grid; gap: 6px; margin: 4px 0; }
  .player { display: grid; grid-template-columns: auto 1fr auto; grid-template-areas: 'dot name rating' 'dot acc acc'; gap: 2px 10px; align-items: center;
    background: var(--surface-2); border: 1px solid var(--line); border-radius: 14px; padding: 8px 12px; }
  .player.win { border-color: color-mix(in srgb, var(--gold) 60%, var(--line)); }
  .player .dot { grid-area: dot; width: 14px; height: 14px; border-radius: 50%; border: 2px solid var(--faint); }
  .dot.white, .pcol.white { background: #fffaf3; }
  .dot.black, .pcol.black { background: #2b1a24; }
  .pname { grid-area: name; font-weight: 800; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .player.win .pname::after { content: ' 🏆'; }
  .prating { grid-area: rating; font-weight: 800; color: var(--muted); font-variant-numeric: tabular-nums; }
  .acc { grid-area: acc; display: flex; align-items: center; gap: 8px; font-size: .8rem; font-weight: 700; color: var(--muted); }
  .acc-bar { flex: 1; height: 6px; border-radius: 99px; background: var(--bg); overflow: hidden; }
  .acc-bar span { display: block; height: 100%; background: var(--mint); border-radius: inherit; animation: grow .8s ease-out .2s backwards; transform-origin: left; }
  @keyframes grow { from { transform: scaleX(0); } }
  .game-link { font-weight: 800; text-decoration: none; justify-self: start; }

  /* ---------- stats ---------- */
  .stats { display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 12px; }
  .stats:empty { display: none; }
  .stat { background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius); padding: 16px; display: grid; gap: 8px; align-content: start; }
  .stat.wide { grid-column: 1 / -1; }
  @media (min-width: 900px) { .stat.trend { grid-column: span 2; } }
  .stat h3, .stat p { margin: 0; }
  .stat h3 { font-size: 1.05rem; }
  .class-row { display: grid; grid-template-columns: 92px 1fr auto; gap: 10px; align-items: center; font-weight: 800; font-size: .9rem; }
  .split { display: flex; height: 12px; border-radius: 99px; overflow: hidden; background: var(--surface-2); gap: 2px; }
  .split span { min-width: 0; }
  .split .me { background: var(--me); }
  .split .dr { background: var(--faint); }
  .split .them { background: var(--them); }
  .split-nums { display: inline-flex; gap: 8px; font-variant-numeric: tabular-nums; min-width: 64px; justify-content: flex-end; }
  .split-nums b:first-child { color: var(--me); }
  .split-nums b:last-child { color: var(--them); }
  .split-nums i { font-style: normal; color: var(--faint); }
  .crow { display: grid; grid-template-columns: 1fr 70px 70px; align-items: center; padding: 6px 0; border-top: 1px solid var(--line); font-weight: 800; }
  .crow.head { border: none; padding: 0; font-size: .78rem; color: var(--faint); }
  .cval { text-align: center; font-variant-numeric: tabular-nums; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .crow:not(.head) .cval.me { color: var(--me); }
  .crow:not(.head) .cval.them { color: var(--them); }
  .pair { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; }
  .pair > div { display: grid; gap: 2px; align-content: start; background: var(--surface-2); border-radius: 12px; padding: 10px; border-top: 3px solid var(--me); min-width: 0; }
  .pair > .them { border-top-color: var(--them); }
  .pair small { font-weight: 800; color: var(--faint); font-size: .72rem; text-transform: uppercase; letter-spacing: .06em; }
  .pair b { font-size: 1rem; overflow-wrap: anywhere; }
  .pair a { text-decoration: none; }
  .spark { width: 100%; height: 80px; overflow: visible; }
  .spark .line { fill: none; stroke-width: 3; stroke-linecap: round; stroke-linejoin: round; stroke-dasharray: 600; animation: draw 1.2s ease-out forwards; stroke-dashoffset: 600; }
  .spark .line.me { stroke: var(--me); }
  .spark .line.them { stroke: var(--them); }
  @keyframes draw { to { stroke-dashoffset: 0; } }
  .legend { display: flex; justify-content: space-between; font-weight: 800; font-size: .86rem; }
  .legend .me { color: var(--me); }
  .legend .them { color: var(--them); }

  /* ---------- history ---------- */
  .history { display: grid; gap: 8px; }
  .history:empty { display: none; }
  .history h3 { margin: 0; }
  .games { display: grid; gap: 6px; }
  .month { margin: 10px 0 2px; font-size: .78rem; font-weight: 800; letter-spacing: .08em; text-transform: uppercase; color: var(--faint); }
  .game { display: grid; grid-template-columns: auto 1fr auto; gap: 12px; align-items: center; text-decoration: none; color: inherit;
    background: var(--surface); border: 1px solid var(--line); border-radius: 14px; padding: 10px 12px; transition: transform .15s, border-color .15s; }
  .game:hover { transform: translateY(-1px); border-color: var(--lilac); }
  .badge { width: 32px; height: 32px; border-radius: 10px; display: grid; place-items: center; font-weight: 900; color: #1a1424; background: var(--faint); }
  .game.win .badge { background: var(--me); }
  .game.loss .badge { background: var(--them); }
  .gtext { display: grid; min-width: 0; }
  .gtext b { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .gtext small { color: var(--muted); font-weight: 700; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .gside { display: inline-flex; align-items: center; gap: 8px; font-weight: 700; color: var(--muted); font-size: .84rem; white-space: nowrap; }
  .pcol { width: 10px; height: 10px; border-radius: 3px; border: 1.5px solid var(--faint); }
  .more { justify-self: center; margin-top: 4px; }
  .fine { text-align: center; font-size: .78rem; margin: 6px 0 0; }

  .catching-up .rivalry, .catching-up .last-game, .catching-up .stats, .catching-up .history { opacity: .7; transition: opacity .3s; }

  @media (max-width: 640px) {
    .last-game { grid-template-columns: 1fr; }
    .last-board { max-width: 360px; width: 100%; justify-self: center; }
    .class-row { grid-template-columns: 78px 1fr auto; }
    .sync-bar { justify-content: center; text-align: center; }
  }
  @media (prefers-reduced-motion: reduce) {
    .knot { animation-duration: .01s; }
    .pc, .headline, .acc-bar span, .spark .line, .kings .k, .side .crown, .gate-icon.spin { animation: none; }
    .spark .line { stroke-dashoffset: 0; }
  }
</style>
