---
import Layout from '../shared/Layout.astro';
import type { ToyMeta } from '../shared/toy';
import { GOOGLE, ARROW } from '../shared/icons.js';

const NEW_FOR_DAYS = 14;
const DAY_MS = 86400000;

const modules = import.meta.glob<{ meta: ToyMeta }>('../toys/*/meta.ts', { eager: true });
const toys = Object.values(modules)
  .map((m) => m.meta)
  .filter((t) => !t.hidden)
  .sort((a, b) => b.added.localeCompare(a.added));
const publicToys = toys.filter((t) => !t.couple); // couple-only toys never show in general mode
const isNew = (t: ToyMeta) => Date.now() - Date.parse(t.added) < NEW_FOR_DAYS * DAY_MS;
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const number = (i: number) => String(publicToys.length - i).padStart(2, '0');
---
<Layout title="made by aryan">
  <!-- One page, five views. Everyone starts at the door; the database decides who gets further. -->
  <div class="views" data-view="checking">

    <section class="view door">
      <div class="lock" aria-hidden="true">🔒</div>
      <h1>Knock knock</h1>
      <p class="muted">This little corner of the internet is for two people. 💌<br />Sign in to see if you're one of them.</p>
      <button class="google-btn" data-signin type="button"><Fragment set:html={GOOGLE} />Sign in with Google</button>
    </section>

    <section class="view checking" aria-live="polite">
      <div class="hearts" aria-hidden="true"><span>💗</span><span>💗</span><span>💗</span></div>
      <p class="muted">Checking the guest list…</p>
    </section>

    <section class="view denied">
      <div class="lock" aria-hidden="true">💌</div>
      <h1>Invite only, for now</h1>
      <p class="muted">You're signed in, but this place only opens with an invite.<br />If someone sent you a link, open that link again.</p>
      <div class="ask">
        <button class="btn" data-ask type="button" style="--pc:var(--pink)">Request access</button>
        <p class="asked" data-asked hidden>Asked ✓ <span class="muted">Aryan will let you in soon. Check back later.</span></p>
      </div>
      <button class="btn ghost" data-switch type="button">Use a different account</button>
    </section>

    <section class="view couple">
      <div class="unlock" aria-hidden="true">💖</div>
      <div class="duo-hero">
        <div class="faces"><span data-me-emoji></span><span class="heart beat">♥</span><span data-partner-emoji></span></div>
        <h1><span data-me-name></span> <span class="heart">♥</span> <span data-partner-name></span></h1>
        <p class="muted" data-together></p>
        <button class="link-btn edit-since" type="button" data-edit-since hidden><span data-days></span> ✎</button>
        <form class="since-form" data-since-form hidden>
          <label>Together since <input type="date" name="since" class="field-input" required /></label>
          <button class="btn" style="--pc:var(--heart)">Save</button>
        </form>
      </div>
      <div class="tiles">
        {toys.map((t) => (
          <a class="tile" href={`${base}${t.slug}/`} style={`--accent: var(--${t.accent})`}>
            <span class="tile-title">{t.title}</span>
            <span class="tile-status" data-status={t.slug}>{t.blurb}</span>
            <span class="tile-go">{t.couple ? 'Open' : 'Play'} <Fragment set:html={ARROW(16)} /></span>
          </a>
        ))}
        <div class="tile tally" data-tally hidden>
          <span class="tile-title">This month</span>
          <span class="tile-status" data-tally-text></span>
        </div>
      </div>
    </section>

    <section class="view general">
      <!-- Groups mode with a group picked: that group's home. -->
      <section class="group-home" data-group-home hidden>
        <div class="gh-icon" data-gh-icon></div>
        <h1 data-gh-name></h1>
        <p class="gh-faces" data-gh-faces></p>
        <div class="gh-actions">
          <button class="btn" type="button" data-gh-invite style="--pc:var(--lilac)">Invite people 💌</button>
          <span class="muted gh-copied" data-gh-copied hidden>Link copied ✓</span>
        </div>
      </section>

      <section class="hero" data-hero>
        <p class="eyebrow">a growing collection of tiny web toys</p>
        <h1>Small, silly,<br /><span class="grad">playable things.</span></h1>
        <p class="lede">Welcome, <strong data-first-name>friend</strong>. Little games to play with your people.</p>
        <div class="hero-actions" data-no-group hidden>
          <button class="btn" type="button" data-start-group style="--pc:var(--pink)">Start a group</button>
          <button class="btn ghost" type="button" data-join-group>Join with a code</button>
        </div>
      </section>

      <div class="section-head">
        <h2 data-toys-head>Toys</h2>
        <span>{publicToys.length} so far</span>
      </div>

      <main class="toys">
        {publicToys.map((t, i) => (
          <a class="toy" href={`${base}${t.groupSlug ?? t.slug}/`} style={`--accent: var(--${t.accent})`}>
            <div class="art"><span class="num">{number(i)}</span>{isNew(t) && <span class="badge">new</span>}</div>
            <div class="body">
              <h3>{t.groupTitle ?? t.title}</h3>
              <p>{t.groupBlurb ?? t.blurb}</p>
              <p class="toy-status" data-toy-status={t.slug} hidden></p>
              <div class="foot">
                <div class="tags">{t.tags?.map((tag) => <span>{tag}</span>)}</div>
                <span class="play">Play <Fragment set:html={ARROW(16)} /></span>
              </div>
            </div>
          </a>
        ))}
        <div class="toy soon">
          <div class="body">
            <h3>More soon</h3>
            <p>Something is cooking.</p>
          </div>
        </div>
      </main>
    </section>
  </div>

  <footer class="site-foot">
    <span>made by aryan</span>
    <nav><a href={`${base}privacy/`}>Privacy</a><a href={`${base}terms/`}>Terms</a></nav>
  </footer>
</Layout>

<script>
  import { supabase, isConfigured, currentUser, signInWithGoogle, firstName } from '../shared/supabase.js';
  import { loadSpace, forgetSpace, emojiOf } from '../shared/space.js';
  import { track, reportError } from '../shared/telemetry.js';
  import { coupleHomeData, groupHomeData } from '../toys/wordle-duo/summary.js';
  import { GROUP_EVENT } from '../shared/space.js';
  import { drinksHomeData } from '../toys/drinks/summary.js';
  import { jarHomeData } from '../toys/date-jar/summary.js';
  import { dateStr } from '../toys/drinks/stats.js';
  import { togetherLabel } from '../shared/together.js';

  const views = document.querySelector<HTMLElement>('.views')!;
  const show = (view: string) => { views.dataset.view = view; };
  const set = (sel: string, text: string) => { document.querySelector(sel)!.textContent = text; };

  document.querySelector('[data-signin]')!.addEventListener('click', async (e) => {
    const button = e.currentTarget as HTMLButtonElement;
    button.disabled = true;
    try { await signInWithGoogle(); } catch (err) { reportError(err, 'door-signin'); button.disabled = false; }
  });
  document.querySelector('[data-switch]')!.addEventListener('click', () => {
    signInWithGoogle().catch((err) => reportError(err, 'door-switch'));
  });

  document.querySelector('[data-edit-since]')!.addEventListener('click', (e) => {
    (e.currentTarget as HTMLElement).hidden = true;
    const form = document.querySelector<HTMLFormElement>('[data-since-form]')!;
    form.hidden = false;
    form.querySelector('input')!.focus();
  });

  async function showCouple(space: any) {
    const { me, partner, room } = space.couple;
    set('[data-me-emoji]', emojiOf(me));
    set('[data-me-name]', me.display_name);
    set('[data-partner-emoji]', partner ? emojiOf(partner) : '💌');
    set('[data-partner-name]', partner ? partner.display_name : 'your person');
    // Once the date is saved the form tucks away; tapping the "together ✎" line brings it back to edit.
    const together = partner ? togetherLabel(room.since, dateStr(new Date())) : null;
    const edit = document.querySelector<HTMLElement>('[data-edit-since]')!;
    const form = document.querySelector<HTMLFormElement>('[data-since-form]')!;
    set('[data-together]', partner ? '' : 'Send them the invite from Wordle Duo settings to complete the pair.');
    set('[data-days]', together ?? '');
    edit.hidden = !together;
    form.hidden = !partner || Boolean(room.since);
    form.querySelector<HTMLInputElement>('input[name="since"]')!.value = room.since ?? '';
    show('couple');
    drinksHomeData(space, supabase)
      .then((line) => set('[data-status="drinks"]', line))
      .catch((err) => reportError(err, 'couple-home-drinks'));
    jarHomeData(space, supabase)
      .then((line) => set('[data-status="date-jar"]', line))
      .catch((err) => reportError(err, 'couple-home-jar'));
    try {
      const data = await coupleHomeData(space, supabase);
      set('[data-status="wordle-duo"]', data.today);
      if (data.tally) {
        document.querySelector<HTMLElement>('[data-tally]')!.hidden = false;
        set('[data-tally-text]', data.tally);
      }
    } catch (err) {
      reportError(err, 'couple-home');
    }
  }

  document.querySelector('[data-since-form]')!.addEventListener('submit', async (e) => {
    e.preventDefault();
    const form = e.currentTarget as HTMLFormElement;
    const since = new FormData(form).get('since') as string;
    const user = await currentUser();
    const space: any = await loadSpace(user!);
    const { error } = await supabase!.rpc('wordle_set_couple', { p_room: space.couple.room.id, p_couple: true, p_since: since });
    if (error) { reportError(error, 'set-since'); return; }
    track('couple_set', { since: true });
    forgetSpace();
    showCouple(await loadSpace(user!));
  });

  // Groups mode: the picked group's home, or an invitation to start one. Redraws when the header switches group.
  function showGeneral(space: any, user: any) {
    document.documentElement.dataset.groups = 'live';
    const g = space.group;
    document.querySelector<HTMLElement>('[data-group-home]')!.hidden = !g;
    document.querySelector<HTMLElement>('[data-hero]')!.hidden = Boolean(g);
    document.querySelector<HTMLElement>('[data-no-group]')!.hidden = Boolean(g);
    set('[data-toys-head]', g ? 'Play together' : 'Toys');
    const status = document.querySelector<HTMLElement>('[data-toy-status="wordle-duo"]');
    if (status) status.hidden = !g;
    show('general');
    if (!g) return;
    set('[data-gh-icon]', g.icon);
    set('[data-gh-name]', g.name);
    document.querySelector('[data-gh-faces]')!.innerHTML = g.members
      .map((m: any) => `<span title="${m.display_name.replace(/"/g, '&quot;')}">${emojiOf(m)}</span>`).join('')
      + `<small>${g.members.length} of ${g.max_members}</small>`;
    if (status) {
      status.textContent = '…';
      groupHomeData(g, user.id, supabase)
        .then((line: string) => { status.textContent = line; })
        .catch((err: unknown) => reportError(err, 'group-home'));
    }
  }

  document.querySelector('[data-gh-invite]')!.addEventListener('click', async () => {
    const user = await currentUser();
    const g = user && (await loadSpace(user) as any).group;
    if (!g) return;
    const link = `${location.origin}${import.meta.env.BASE_URL.replace(/\/?$/, '/')}wordle-leaderboard/?join=${g.invite_code}`;
    try {
      if (navigator.share) {
        await navigator.share({ title: 'Wordle Leaderboard', text: `Join "${g.name}" on my Wordle leaderboard ${g.icon}`, url: link });
        track('wordle_invite_shared', { method: 'share', where: 'group-home' });
        return;
      }
    } catch { /* cancelled: copy instead */ }
    try {
      await navigator.clipboard.writeText(link);
      track('wordle_invite_shared', { method: 'copy', where: 'group-home' });
      const copied = document.querySelector<HTMLElement>('[data-gh-copied]')!;
      copied.hidden = false;
      setTimeout(() => { copied.hidden = true; }, 1800);
    } catch {
      prompt('Copy this invite link:', link);
    }
  });
  // These open the header's dialogs, so starting or joining works the same everywhere.
  document.querySelector('[data-start-group]')!.addEventListener('click', () => document.querySelector<HTMLElement>('[data-gs="new"]')?.click());
  document.querySelector('[data-join-group]')!.addEventListener('click', () => document.querySelector<HTMLElement>('[data-gs="join"]')?.click());

  window.addEventListener(GROUP_EVENT, async () => {
    const user = await currentUser();
    if (!user) return;
    const space: any = await loadSpace(user);
    if (space.mode === 'general' && space.access) showGeneral(space, user);
  });

  async function route() {
    if (!isConfigured) { show('door'); return; }
    let user;
    try { user = await currentUser(); } catch (err) { reportError(err, 'door-session'); show('door'); return; }
    if (!user) { show('door'); return; }
    try {
      const space: any = await loadSpace(user);
      if (space.couple && space.mode === 'couple') { await showCouple(space); return; }
      if (space.access) {
        set('[data-first-name]', firstName(user) || 'friend');
        showGeneral(space, user);
        return;
      }
      track('access_denied');
      show('denied');
      showAsked(await supabase.rpc('my_access_request').then(({ data }) => data).catch(() => null));
    } catch (err) {
      reportError(err, 'door-route');
      show('denied');
    }
  }

  // Invite-only screen: one tap puts you on Aryan's list (the SQL editor approves).
  const askBtn = document.querySelector<HTMLButtonElement>('[data-ask]')!;
  const showAsked = (at: string | null) => {
    askBtn.hidden = Boolean(at);
    document.querySelector<HTMLElement>('[data-asked]')!.hidden = !at;
  };
  askBtn.addEventListener('click', async () => {
    askBtn.disabled = true;
    const { data, error } = await supabase.rpc('request_access');
    askBtn.disabled = false;
    if (error) { reportError(error, 'request-access'); return; }
    if (data === null) { location.reload(); return; } // already let in
    track('access_requested');
    showAsked(data);
  });

  route();
</script>

<style>
  .view { display: none; }
  .views[data-view="door"] .door, .views[data-view="checking"] .checking, .views[data-view="denied"] .denied,
  .views[data-view="couple"] .couple, .views[data-view="general"] .general { display: block; }

  /* door, checking, denied */
  .door, .checking, .denied { text-align: center; padding: 12vh 0 8vh; max-width: 520px; margin: 0 auto; }
  .door h1, .denied h1 { margin: 10px 0 6px; font-size: clamp(2rem, 6vw, 2.8rem); }
  .door p, .denied p { margin: 0 0 24px; font-size: 1.05rem; line-height: 1.6; }
  .muted { color: var(--muted); }
  .ask { margin: 0 0 18px; }
  .asked { font-weight: 600; margin: 0; }
  .lock { font-size: 4rem; display: inline-block; animation: wiggle 2.6s ease-in-out infinite; }
  @keyframes wiggle { 0%, 78%, 100% { transform: rotate(0); } 84% { transform: rotate(-12deg); } 90% { transform: rotate(10deg); } 95% { transform: rotate(-5deg); } }
  .hearts { font-size: 1.8rem; display: flex; justify-content: center; gap: 10px; }
  .hearts span { animation: hop 1.1s ease-in-out infinite; }
  .hearts span:nth-child(2) { animation-delay: .15s; } .hearts span:nth-child(3) { animation-delay: .3s; }
  @keyframes hop { 0%, 100% { transform: translateY(0); opacity: .5; } 40% { transform: translateY(-10px); opacity: 1; } }

  /* couple home */
  .couple { position: relative; padding-top: 24px; }
  .unlock { position: absolute; left: 50%; top: 40px; font-size: 3rem; pointer-events: none; animation: unlock 1.1s ease-out forwards; }
  @keyframes unlock { 0% { transform: translateX(-50%) scale(.4); opacity: 0; } 35% { transform: translateX(-50%) scale(1.25); opacity: 1; } 100% { transform: translateX(-50%) translateY(-60px) scale(.9); opacity: 0; } }
  .duo-hero { text-align: center; margin-bottom: 30px; animation: rise .7s .25s both cubic-bezier(.2, 1.2, .4, 1); }
  @keyframes rise { from { opacity: 0; transform: translateY(14px); } }
  .faces { font-size: clamp(3rem, 10vw, 4.4rem); display: flex; justify-content: center; align-items: center; gap: 14px; line-height: 1; }
  .faces .heart { font-size: .5em; }
  .duo-hero h1 { margin: 12px 0 4px; font-size: clamp(1.8rem, 5vw, 2.5rem); }
  .duo-hero h1 .heart { font-size: .8em; }
  .duo-hero p { margin: 0; }
  .since-form { margin: 14px auto 0; display: flex; gap: 8px; justify-content: center; align-items: flex-end; flex-wrap: wrap; }
  .since-form label { display: flex; flex-direction: column; gap: 4px; font-size: .82rem; font-weight: 700; color: var(--muted); text-align: left; }
  .since-form .field-input { width: auto; color-scheme: dark; }
  .edit-since { color: var(--muted); font-weight: 600; font-size: 1rem; }
  .edit-since:hover { color: var(--text); }

  .tiles { display: grid; grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); gap: 14px; }
  .tile { display: flex; flex-direction: column; gap: 6px; padding: 18px 18px 16px; border-radius: var(--radius); color: inherit; text-decoration: none; min-height: 150px;
    background: linear-gradient(150deg, color-mix(in srgb, var(--accent) 16%, var(--surface)), var(--surface) 70%);
    outline: 1px solid color-mix(in srgb, var(--accent) 30%, var(--line)); transition: transform .2s, box-shadow .2s; }
  a.tile:hover { transform: translateY(-3px); box-shadow: 0 14px 36px color-mix(in srgb, var(--accent) 20%, transparent); }
  .tile-title { font-family: Fredoka, sans-serif; font-weight: 700; font-size: 1.3rem; }
  .tile-status { color: var(--muted); font-size: .95rem; }
  .tile-go { margin-top: auto; display: inline-flex; align-items: center; gap: 4px; font-weight: 800; color: var(--accent); }
  .tile.soon { outline-style: dashed; background: transparent; }
  .tile.tally { --accent: var(--heart); }

  /* group home */
  .group-home { text-align: center; padding: 40px 0 34px; animation: rise .6s both cubic-bezier(.2, 1.2, .4, 1); }
  .gh-icon { font-size: clamp(3rem, 10vw, 4.2rem); line-height: 1; }
  .group-home h1 { margin: 10px 0 8px; font-size: clamp(2rem, 6vw, 2.8rem); }
  .gh-faces { margin: 0; font-size: 1.6rem; display: flex; justify-content: center; align-items: center; gap: 4px; flex-wrap: wrap; }
  .gh-faces small { font-size: .85rem; color: var(--faint); font-weight: 700; margin-left: 8px; }
  .gh-actions { margin-top: 18px; display: flex; justify-content: center; align-items: center; gap: 12px; }
  .hero-actions { margin-top: 24px; display: flex; gap: 10px; flex-wrap: wrap; }
  .hero-actions .btn { padding: 11px 18px; font-size: 1rem; }
  .toy-status { color: var(--text) !important; font-weight: 700; font-size: .9rem !important; }

  /* general */
  .hero { padding: 56px 0 44px; max-width: 720px; }
  .eyebrow { margin: 0 0 14px; color: var(--muted); font-weight: 700; font-size: .8rem; letter-spacing: 1.6px; text-transform: uppercase; }
  .hero h1 { margin: 0; font-size: clamp(2.5rem, 7.5vw, 4.4rem); line-height: 1.02; font-weight: 700; letter-spacing: -.5px; }
  .grad { background: linear-gradient(100deg, var(--pink), var(--lilac) 45%, var(--blue)); -webkit-background-clip: text; background-clip: text; color: transparent; }
  .lede { margin: 18px 0 0; color: var(--muted); font-size: 1.12rem; max-width: 520px; }
  .lede strong { color: var(--text); }

  .section-head { display: flex; align-items: baseline; justify-content: space-between; margin: 8px 0 16px;
    padding-top: 22px; border-top: 1px solid color-mix(in srgb, var(--line) 60%, transparent); }
  .section-head h2 { margin: 0; font-size: 1.3rem; }
  .section-head span { color: var(--faint); font-size: .9rem; font-weight: 700; }

  .toys { display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 18px; }
  .toy { display: flex; flex-direction: column; border-radius: var(--radius); overflow: hidden; color: inherit; text-decoration: none;
    background: var(--surface); outline: 1px solid color-mix(in srgb, var(--line) 70%, transparent); transition: transform .2s, outline-color .2s, box-shadow .2s; }
  .toy:hover { transform: translateY(-4px); outline-color: var(--accent); box-shadow: 0 16px 40px color-mix(in srgb, var(--accent) 18%, transparent); }
  .art { position: relative; height: 130px; display: flex; align-items: flex-end; padding: 14px 16px;
    background:
      radial-gradient(circle at 1px 1px, color-mix(in srgb, var(--accent) 45%, transparent) 1px, transparent 0) 0 0 / 14px 14px,
      radial-gradient(120% 140% at 0% 0%, color-mix(in srgb, var(--accent) 40%, transparent), transparent 70%),
      var(--surface-2); }
  .num { font-family: Fredoka, sans-serif; font-size: 3rem; font-weight: 700; line-height: 1; color: var(--accent); opacity: .9; }
  .badge { position: absolute; top: 12px; right: 12px; background: var(--gold); color: #1a1424;
    font-weight: 800; font-size: .7rem; padding: 3px 9px; border-radius: 999px; text-transform: uppercase; letter-spacing: .6px; }
  .body { padding: 16px 18px 18px; display: flex; flex-direction: column; gap: 6px; flex: 1; }
  .body h3 { margin: 0; font-size: 1.25rem; }
  .body p { margin: 0; color: var(--muted); font-size: .95rem; }
  .foot { margin-top: auto; padding-top: 12px; display: flex; align-items: center; justify-content: space-between; gap: 10px; }
  .tags { display: flex; gap: 6px; flex-wrap: wrap; }
  .tags span { font-size: .75rem; font-weight: 700; color: var(--muted); padding: 2px 9px; border-radius: 999px; background: var(--surface-2); }
  .play { display: inline-flex; align-items: center; gap: 4px; font-weight: 800; color: var(--accent); white-space: nowrap; }
  .play :global(svg), .tile-go :global(svg) { transition: transform .2s; }
  .toy:hover .play :global(svg), a.tile:hover .tile-go :global(svg) { transform: translateX(3px); }
  .toy.soon { background: transparent; outline: 1px dashed var(--line); min-height: 160px; justify-content: center; }
  .toy.soon .body { flex: 0; }
  .toy.soon:hover { transform: none; box-shadow: none; outline-color: var(--line); }

  .site-foot { margin-top: 56px; padding-top: 20px; display: flex; justify-content: space-between; gap: 12px; flex-wrap: wrap;
    border-top: 1px solid color-mix(in srgb, var(--line) 60%, transparent); color: var(--faint); font-size: .88rem; }
  .site-foot nav { display: flex; gap: 18px; }
  .site-foot a { color: var(--muted); text-decoration: none; }
  .site-foot a:hover { color: var(--text); }
</style>
