---
import Layout from '../shared/Layout.astro';
import type { ToyMeta } from '../shared/toy';

const NEW_FOR_DAYS = 14;
const DAY_MS = 86400000;

const modules = import.meta.glob<{ meta: ToyMeta }>('../toys/*/meta.ts', { eager: true });
const toys = Object.values(modules)
  .map((m) => m.meta)
  .filter((t) => !t.hidden)
  .sort((a, b) => b.added.localeCompare(a.added));
const isNew = (t: ToyMeta) => Date.now() - Date.parse(t.added) < NEW_FOR_DAYS * DAY_MS;
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---
<Layout title="made by aryan" emoji="✨">
  <header class="hero">
    <h1>made by aryan <span class="spark">✨</span></h1>
    <p>small, silly, playable things. new ones show up whenever.</p>
  </header>

  <main class="toys">
    {toys.map((t) => (
      <a class="toy" href={`${base}${t.slug}/`}>
        {isNew(t) && <span class="badge">new</span>}
        <span class="emoji">{t.emoji}</span>
        <span class="title">{t.title}</span>
        <span class="blurb">{t.blurb}</span>
      </a>
    ))}
    <div class="toy soon">
      <span class="emoji">🧪</span>
      <span class="title">more soon</span>
      <span class="blurb">something is cooking</span>
    </div>
  </main>

  <footer>{toys.length} toy{toys.length === 1 ? '' : 's'} so far · <a href={`${base}privacy/`}>privacy</a> · <a href={`${base}terms/`}>terms</a></footer>
</Layout>

<style>
  .hero { text-align: center; margin: 24px 0 34px; }
  .hero h1 { margin: 0; font-size: clamp(2rem, 6vw, 3.2rem); }
  .hero p { margin: 6px 0 0; color: var(--muted); }
  .spark { display: inline-block; animation: twinkle 2.4s ease-in-out infinite; }
  @keyframes twinkle { 50% { transform: rotate(18deg) scale(1.15); } }
  .toys { display: grid; grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); gap: 14px; }
  .toy {
    position: relative; display: flex; flex-direction: column; gap: 6px; padding: 20px 18px; min-height: 170px;
    border-radius: var(--radius); background: var(--surface); border: 1px solid var(--line);
    color: inherit; text-decoration: none; transition: transform .15s, border-color .15s;
  }
  .toy:hover { transform: translateY(-3px) rotate(-.6deg); border-color: var(--pink); }
  .toy .emoji { font-size: 2.4rem; }
  .toy .title { font-family: Fredoka, sans-serif; font-weight: 600; font-size: 1.2rem; }
  .toy .blurb { color: var(--muted); font-size: .92rem; }
  .toy.soon { border-style: dashed; opacity: .6; }
  .toy.soon:hover { transform: none; border-color: var(--line); }
  .badge {
    position: absolute; top: 12px; right: 12px; background: var(--gold); color: #1a1424;
    font-weight: 800; font-size: .72rem; padding: 2px 8px; border-radius: 999px; text-transform: uppercase;
  }
  footer { margin-top: 40px; text-align: center; color: var(--faint); font-size: .85rem; }
  footer a { color: inherit; }
</style>
