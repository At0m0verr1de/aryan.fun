---
import Layout from '../shared/Layout.astro';
import { meta } from '../toys/our-pet/meta';
---
<Layout title={`${meta.title} · made by aryan`} description={meta.blurb} crumb={meta.title} full>
  <Fragment slot="head">
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,600&display=swap" rel="stylesheet" />
  </Fragment>

  <div id="gate"><div class="card center gate-card">Knocking on the door…</div></div>

  <div id="pet-page" class="scene t-day" hidden>
    <div id="room-host" class="room-host"></div>
    <div class="vignette" aria-hidden="true"></div>
    <div id="fx" class="fx" aria-hidden="true"></div>
    <div id="caption" class="caption" role="status" aria-live="polite"></div>
    <button id="blink-back" class="blink-back" data-action="blink-back" type="button" hidden>Slow-blink back</button>

    <header class="hud">
      <div id="hud-name" class="hud-name" hidden>
        <h1 id="pet-name"></h1>
        <p id="pet-sub"></p>
      </div>
      <div id="vitals" class="vitals glass" hidden></div>
    </header>

    <div id="dock-wrap" class="dock-wrap" hidden>
      <p id="hint" class="hint"></p>
      <nav class="dock glass" aria-label="Things to do">
        <div class="pantry">
          <div id="pantry-items" class="pantry-items"></div>
          <small id="food-left"></small>
        </div>
        <span class="dock-sep" aria-hidden="true"></span>
        <button id="feather-btn" class="dock-btn" data-action="feather" type="button" aria-pressed="false">
          <svg viewBox="0 0 40 40" aria-hidden="true"><path d="M8 36 L26 8" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" /><path d="M26 8 C34 6 38 12 34 18 C30 22 24 20 26 8 Z" fill="currentColor" opacity=".55" /></svg>
          <span>Feather</span><small id="play-left"></small>
        </button>
        <button class="dock-btn" data-action="journal" type="button">
          <svg viewBox="0 0 40 40" aria-hidden="true"><rect x="9" y="6" width="22" height="28" rx="3" fill="none" stroke="currentColor" stroke-width="2.4" /><path d="M14 14 H26 M14 20 H26 M14 26 H21" stroke="currentColor" stroke-width="2" stroke-linecap="round" /></svg>
          <span>Journal</span><small>&nbsp;</small>
        </button>
      </nav>
    </div>

    <form id="adopt" class="panel glass adopt" autocomplete="off" hidden>
      <h2>A new egg</h2>
      <p id="adopt-intro" class="muted"></p>
      <div id="eggs" class="eggs" role="group" aria-label="Choose an egg"></div>
      <label class="field-label" for="adopt-name">Name</label>
      <input class="field-input" id="adopt-name" maxlength="20" placeholder="Mochi" />
      <div id="name-ideas" class="chips"></div>
      <p id="adopt-error" class="form-error" role="alert"></p>
      <button id="hatch-btn" class="btn-soft primary" type="submit">Hatch</button>
      <p class="muted small">You share this cat, so you both look after it. Feed it, play with it, and visit at least once a week.</p>
    </form>

    <section id="goodbye" class="panel glass goodbye" hidden></section>

    <div id="journal-shade" class="journal-shade" data-action="close-journal" hidden></div>
    <aside id="journal" class="journal" aria-label="Journal" hidden>
      <header><h2><span id="j-name"></span>'s journal</h2><button class="x" data-action="close-journal" type="button" aria-label="Close">×</button></header>
      <section>
        <h3>Things that cheer them up</h3>
        <p class="muted small">Each of you playing one of these gives a boost, once a day each.</p>
        <div id="j-toys" class="j-toys"></div>
      </section>
      <section><h3>Lately</h3><ul id="j-diary" class="j-diary"></ul></section>
      <section>
        <h3>How it works</h3>
        <ul class="j-how">
          <li><b>Food:</b> drag a dish from the pantry onto the floor, or tap it to fill the bowl. Three meals a day between you.</li>
          <li><b>Play:</b> pick up the yarn ball and throw it, or wave the feather near the floor.</li>
          <li><b>Cuddles:</b> stroke the cat slowly. Quick taps are boops, and too many in a row aren't always welcome.</li>
          <li>Meters drain over time. If nobody visits for a week, the cat leaves.</li>
        </ul>
      </section>
      <section id="j-memorial" hidden><h3>Remembered</h3><ul id="j-graves" class="j-graves"></ul></section>
    </aside>

    <div id="drag-ghost" class="drag-ghost" hidden></div>
  </div>
</Layout>

<script>
  import '../toys/our-pet/app.js';
</script>

<style is:global>
  .muted { color: var(--muted); }
  .scene .muted { color: var(--glass-muted); }
  .small { font-size: .82rem; }
  .center { text-align: center; }
  .narrow { max-width: 460px; margin: 0 auto; }
  #gate { padding: 28px 16px; }
  #gate .card { display: flex; flex-direction: column; gap: 12px; align-items: center; }
  #gate h2, #gate p { margin: 0; }
  #gate .btn { text-decoration: none; }

  /* ---------- time of day: the room reads these ---------- */
  .scene {
    --sky-top: #6fa8de; --sky-low: #d4e7f5; --wall-top: #efe6da; --wall-low: #e5d8c7; --wains-top: #dccbb4; --wains-low: #cfbca2; --trim: #f7f1e8;
    --floor-back: #a8714c; --floor-front: #7a4b30; --far: #a9bfd4; --trees: #6f9a72; --tint: #202a58; --tint-op: 0; --warm: #ffb070; --warm-op: 0;
    --winglow: .45; --lamp: 0; --beam: .4; --moonbeam: 0; --stars: 0; --moon: 0; --sun: 1; --citylights: 0; --cloud: #ffffff;
    --ink: #2a2420; --glass: rgba(255, 252, 247, .72); --glass-line: rgba(60, 45, 35, .12); --glass-text: #2a2420; --glass-muted: #7a6c62;
  }
  .scene.t-morning { --sky-top: #9fc3e6; --sky-low: #f7d2b0; --warm: #ffb070; --warm-op: .18; --beam: .55; --winglow: .5; --far: #b9c3d6; }
  .scene.t-evening { --sky-top: #57609e; --sky-low: #f29a62; --wall-top: #e9d8c6; --wall-low: #dcc5ad; --warm: #ff7a3c; --warm-op: .24; --lamp: .55;
    --beam: .18; --winglow: .25; --citylights: .4; --far: #6c6a8e; --trees: #4f6a55; --cloud: #ffc6a3; --sun: .8; }
  .scene.t-night { --sky-top: #070b1f; --sky-low: #1f2347; --tint-op: .68; --lamp: 1; --beam: 0; --moonbeam: .25; --stars: 1; --moon: 1; --sun: 0;
    --citylights: 1; --winglow: .08; --far: #1b2040; --trees: #1d2b2a; --cloud: #3b4166;
    --glass: rgba(22, 20, 34, .66); --glass-line: rgba(255, 255, 255, .1); --glass-text: #f3ede6; --glass-muted: #b4a9a0; }

  /* ---------- the scene ---------- */
  .scene { position: relative; height: calc(100svh - 61px); min-height: 540px; overflow: hidden; background: #d8cbbb; color: var(--glass-text);
    user-select: none; -webkit-user-select: none; touch-action: none; font-family: Nunito, system-ui, sans-serif; }
  .scene[hidden] { display: none; }
  .room-host, .room { position: absolute; inset: 0; width: 100%; height: 100%; display: block; }
  .scene.grabbing, .scene.grabbing * { cursor: grabbing !important; }
  .scene.feathering .room-host { cursor: none; }
  .vignette { position: absolute; inset: 0; pointer-events: none; background: radial-gradient(ellipse at 50% 45%, transparent 55%, rgba(20, 12, 8, .28)); }
  .t-night .vignette { background: radial-gradient(ellipse at 50% 45%, transparent 45%, rgba(4, 4, 12, .5)); }
  .scene.mourning .room { filter: saturate(.35) brightness(.92); transition: filter 2s; }

  /* room paint */
  .room .trim { fill: var(--trim); }
  .room .panel-line { stroke: #000; stroke-opacity: .07; stroke-width: 2; }
  .room .seams { stroke: #3a2216; stroke-opacity: .22; stroke-width: 1.4; fill: none; }
  .room .mullions { stroke: var(--trim); stroke-width: 8; fill: none; }
  .room .stars circle { fill: #fff; opacity: var(--stars); animation: twinkle 3.2s ease-in-out infinite; }
  @keyframes twinkle { 50% { opacity: calc(var(--stars) * .25); } }
  .room #sun { opacity: var(--sun); transition: opacity 2s; }
  .room .sun-disc { fill: #fff6d8; }
  .room #moon { opacity: var(--moon); transition: opacity 2s; }
  .room .cloud { fill: var(--cloud); opacity: .85; }
  .room .cloud.c1 { animation: cloud 70s linear infinite; }
  .room .cloud.c2 { animation: cloud 95s linear infinite -40s; }
  @keyframes cloud { from { transform: translate(360px, 150px); } to { transform: translate(820px, 130px); } }
  .room .far { fill: var(--far); transition: fill 2s; }
  .room .city-lights rect { fill: #ffd98a; opacity: var(--citylights); }
  .room .trees circle { fill: var(--trees); transition: fill 2s; }
  .room .blooms circle { fill: #f4b8c4; opacity: .9; }
  .t-night .room .blooms circle { opacity: .25; }
  .room .bird { fill: none; stroke: #2a2a33; stroke-width: 2.4; stroke-linecap: round; animation: bird 4.2s linear forwards; }
  @keyframes bird { from { transform: translate(410px, var(--y)); } to { transform: translate(780px, calc(var(--y) - 60px)); } }
  .room .curtain { transform-box: fill-box; transform-origin: 50% 0; animation: curtain 9s ease-in-out infinite; }
  .room .curtain.r { animation-delay: -4s; }
  @keyframes curtain { 50% { transform: skewX(1.2deg); } }
  .room .sway { transform-box: fill-box; transform-origin: 50% 100%; animation: sway 7s ease-in-out infinite; }
  @keyframes sway { 50% { transform: rotate(1.4deg); } }
  .room .beam { opacity: var(--beam); transition: opacity 3s; mix-blend-mode: screen; }
  .room .motes circle { fill: #fff8e2; animation: mote 12s ease-in-out infinite; }
  @keyframes mote { 0%, 100% { transform: translate(0, 0); opacity: .2; } 50% { transform: translate(14px, -24px); opacity: .9; } }
  .room .moonbeam { opacity: calc(var(--moonbeam) * 4); mix-blend-mode: screen; }
  .room .bulb { opacity: calc(.4 + var(--lamp) * .6); }
  .room .cone { opacity: calc(var(--lamp) * .5); mix-blend-mode: screen; }
  .room .tint { fill: var(--tint); opacity: var(--tint-op); mix-blend-mode: multiply; pointer-events: none; transition: opacity 3s; }
  .room .warm { fill: var(--warm); opacity: var(--warm-op); mix-blend-mode: soft-light; pointer-events: none; }
  .room .winglow { opacity: var(--winglow); mix-blend-mode: screen; pointer-events: none; }
  .room .lampglow { opacity: var(--lamp); mix-blend-mode: screen; pointer-events: none; }

  /* ---------- the cat ---------- */
  .room .fur { fill: url(#g-fur); }
  .room .cat-body .belly { fill: var(--fur3); opacity: .5; }
  .room .head-fur { fill: url(#g-head); }
  .room .iris { fill: url(#g-iris); }
  .room .pupil { fill: #0d0b0c; }
  .room .glint { fill: #fff; opacity: .92; }
  .room .leg { fill: none; stroke: url(#g-fur); stroke-width: 17; stroke-linecap: round; stroke-linejoin: round; }
  .room .leg.far { stroke: var(--far-leg); }
  .room .paw { fill: var(--paw); }
  .room .paw.far { fill: var(--far-leg); }
  .room .ear-in { fill: var(--ear-in); }
  .room .nose { fill: var(--nose); }
  .room .whiskers path { stroke: var(--whisker); stroke-width: 1.3; stroke-linecap: round; opacity: .8; fill: none; }
  .room .mouth.m-w { fill: none; stroke: #120f12; stroke-width: 2.2; stroke-linecap: round; }
  .room .mouth.m-open, .room .m-yawn ellipse { fill: #5a2230; }
  .room .fang { fill: #fff; }
  .room .tongue { fill: #e88a9a; }
  .room .collar { fill: none; stroke: var(--collar); stroke-width: 6; stroke-linecap: round; }
  .room .bell { fill: #d9b24a; stroke: #a8852e; stroke-width: 1.2; }
  .room .stripes, .room .stripes path { fill: none; stroke: var(--stripe); stroke-width: 5; stroke-linecap: round; }
  .room .bib { fill: #f4f1ee; opacity: var(--bib-op); }
  .room .lid { fill: none; stroke: #120f12; stroke-width: 2.6; stroke-linecap: round; }
  .room .cat-shadow { fill: #1a1210; opacity: .3; filter: url(#f-soft); }
  .t-night .room .cat-root { filter: drop-shadow(0 0 1.5px rgba(255, 210, 150, .55)); }
  .t-night .room .iris { filter: brightness(1.25); }
  .room .cat-root.ghost { opacity: .6; filter: grayscale(1) contrast(.4) brightness(2.2) drop-shadow(0 0 10px rgba(220, 230, 255, .9)); }
  .room .cat-root.ghost .cat-shadow { opacity: .08; }

  /* ---------- props ---------- */
  .room .prop-shadow { fill: #1a1210; opacity: .3; filter: url(#f-soft); }
  .room .yarn { fill: #e0705f; }
  .room .yarn-lines { fill: none; stroke: #b84c40; stroke-width: 2; stroke-linecap: round; }
  .room .yarn-tail { fill: none; stroke: #e0705f; stroke-width: 2.6; stroke-linecap: round; }
  .room .yarn-ball { cursor: grab; }
  .room .yarn-ball.held { filter: drop-shadow(0 10px 8px rgba(0, 0, 0, .25)); }
  .room #feather { pointer-events: none; transition: opacity .3s; }
  .room #feather .rod { stroke: #8b6a45; stroke-width: 5; stroke-linecap: round; }
  .room #feather .string { stroke: #f2eadf; stroke-width: 1.6; fill: none; opacity: .9; }
  .room #feather .plume path:first-child { fill: #d6564b; }
  .room #feather .quill { stroke: #f7e6d0; stroke-width: 1.5; }
  .room #feather .barbs { stroke: #ffb3a6; stroke-width: 1.4; fill: none; opacity: .7; }

  /* egg in the room */
  .room .egg-wobble { transform-box: fill-box; transform-origin: 50% 100%; animation: egg-wobble 2.8s ease-in-out infinite; }
  @keyframes egg-wobble { 0%, 58%, 100% { transform: rotate(0); } 66% { transform: rotate(-6deg); } 76% { transform: rotate(5deg); } 86% { transform: rotate(-2deg); } }
  .room .egg-crack { fill: none; stroke: #1b1714; stroke-width: 3; stroke-linejoin: round; stroke-dasharray: 160; stroke-dashoffset: 160; transition: stroke-dashoffset 1.2s; }
  .room .egg-top, .room .egg-bottom { transition: transform .8s cubic-bezier(.2, .9, .3, 1), opacity .8s; }
  .room .room-egg.cracking .egg-wobble { animation: egg-shake .12s linear infinite; }
  .room .room-egg.cracking .egg-crack { stroke-dashoffset: 0; }
  @keyframes egg-shake { 50% { transform: rotate(3deg) translateX(1.5px); } }
  .room .room-egg.hatched .egg-wobble { animation: none; }
  .room .room-egg.hatched .egg-crack { opacity: 0; }
  .room .room-egg.hatched .egg-top { transform: translate(60px, -130px) rotate(40deg); opacity: 0; }
  .room .room-egg.hatched .egg-bottom { transform: translate(-30px, 10px) rotate(-14deg); opacity: 0; transition-delay: .3s; }

  /* ---------- floating UI ---------- */
  .glass { background: var(--glass); border: 1px solid var(--glass-line); backdrop-filter: blur(14px) saturate(1.2); -webkit-backdrop-filter: blur(14px) saturate(1.2);
    box-shadow: 0 10px 30px rgba(30, 20, 10, .12); color: var(--glass-text); transition: background 2s, color 2s; }
  .hud { position: absolute; top: 18px; left: 22px; right: 22px; display: flex; justify-content: space-between; align-items: flex-start; gap: 16px; pointer-events: none; }
  .hud > * { pointer-events: auto; }
  .hud-name h1 { margin: 0; font-family: Fraunces, Georgia, serif; font-weight: 500; font-size: clamp(1.9rem, 4vw, 2.8rem); letter-spacing: -.01em; line-height: 1;
    color: var(--glass-text); text-shadow: 0 1px 12px rgba(255, 255, 255, .25); }
  .t-night .hud-name h1 { text-shadow: 0 1px 12px rgba(0, 0, 0, .4); }
  .hud-name p { margin: 6px 0 0; font-size: .86rem; font-weight: 700; color: var(--glass-muted); letter-spacing: .02em; }
  .vitals { display: grid; gap: 7px; padding: 12px 14px; border-radius: 16px; min-width: 230px; }
  .vital { display: grid; grid-template-columns: 52px 1fr 66px; align-items: center; gap: 10px; font-size: .78rem; font-weight: 800; }
  .v-label { color: var(--glass-muted); text-transform: uppercase; letter-spacing: .08em; font-size: .66rem; }
  .v-bar { height: 5px; border-radius: 9px; background: color-mix(in srgb, var(--glass-text) 12%, transparent); overflow: hidden; }
  .v-bar i { display: block; height: 100%; border-radius: inherit; background: #6fae8c; transition: width 1s cubic-bezier(.2, 1, .3, 1); }
  .vital.mid .v-bar i { background: #d9a441; }
  .vital.low .v-bar i { background: #d9655a; animation: pulse 1.4s ease-in-out infinite; }
  .vital.low .v-word { color: #d9655a; }
  @keyframes pulse { 50% { opacity: .5; } }
  .v-word { text-align: right; }

  .caption { position: absolute; left: 50%; top: 40%; transform: translate(-50%, -100%) translateY(6px); opacity: 0; pointer-events: none; max-width: min(300px, 76vw);
    padding: 9px 14px; border-radius: 14px; background: rgba(255, 252, 247, .92); color: #2a2420; font-size: .92rem; font-weight: 700; line-height: 1.35; text-align: center;
    box-shadow: 0 8px 22px rgba(30, 20, 10, .16); transition: opacity .3s, transform .3s cubic-bezier(.2, 1.3, .4, 1); font-style: italic; }
  .caption::after { content: ''; position: absolute; left: 50%; bottom: -6px; margin-left: -6px; border: 6px solid transparent; border-top-color: rgba(255, 252, 247, .92); border-bottom: 0; }
  .caption.show { opacity: 1; transform: translate(-50%, -100%) translateY(-6px); }
  .blink-back { position: absolute; transform: translate(-50%, -50%); border: 1px solid var(--glass-line); background: var(--glass); color: var(--glass-text);
    backdrop-filter: blur(10px); padding: 7px 12px; border-radius: 999px; font: 700 .8rem Nunito, sans-serif; cursor: pointer; animation: fade-in .4s; }
  @keyframes fade-in { from { opacity: 0; } }

  .fx { position: absolute; inset: 0; pointer-events: none; overflow: hidden; }
  .fx-p { position: absolute; color: #e07a8b; font-size: 1.1rem; transform: translate(-50%, -50%); animation: float-up 2.2s ease-out forwards; text-shadow: 0 1px 4px rgba(0, 0, 0, .15); }
  .fx-p.heart svg { width: 16px; height: 15px; display: block; fill: #e0788a; filter: drop-shadow(0 1px 3px rgba(0, 0, 0, .2)); }
  .fx-p.zzz { color: var(--glass-muted); font-family: Fraunces, serif; font-style: italic; font-size: 1.2rem; animation-duration: 2.6s; }
  @keyframes float-up { 0% { opacity: 0; transform: translate(-50%, -50%) scale(.5); } 15% { opacity: 1; }
    100% { opacity: 0; transform: translate(calc(-50% + var(--dx)), -90px) scale(1.1); } }

  .dock-wrap { position: absolute; left: 0; right: 0; bottom: 18px; display: grid; justify-items: center; gap: 8px; padding: 0 12px; pointer-events: none; }
  .dock-wrap > * { pointer-events: auto; }
  .dock-wrap[hidden] { display: none; }
  .hint { margin: 0; font-size: .8rem; font-weight: 700; color: var(--glass-text); background: var(--glass); padding: 5px 12px; border-radius: 999px; opacity: 0;
    transition: opacity .6s; pointer-events: none; backdrop-filter: blur(8px); text-align: center; }
  .hint.show { opacity: .92; }
  .dock { display: flex; align-items: stretch; gap: 6px; padding: 8px; border-radius: 22px; max-width: 100%; }
  .pantry { display: grid; gap: 2px; justify-items: center; }
  .pantry-items { display: flex; gap: 4px; }
  .pantry small, .dock-btn small { font-size: .66rem; font-weight: 700; color: var(--glass-muted); white-space: nowrap; }
  .food-btn, .dock-btn { display: grid; justify-items: center; gap: 1px; border: none; background: transparent; color: var(--glass-text); border-radius: 14px; padding: 6px 8px;
    cursor: grab; font: 800 .72rem Nunito, sans-serif; touch-action: none; transition: background .2s, transform .15s; }
  .dock-btn { cursor: pointer; min-width: 64px; }
  .food-btn:hover, .dock-btn:hover { background: color-mix(in srgb, var(--glass-text) 8%, transparent); }
  .food-btn:active, .dock-btn:active { transform: scale(.94); }
  .food-btn svg { width: 46px; height: 28px; overflow: visible; }
  .dock-btn svg { width: 28px; height: 28px; }
  .dock-btn[aria-pressed="true"] { background: color-mix(in srgb, #d6564b 18%, transparent); }
  .dock-sep { width: 1px; background: var(--glass-line); margin: 6px 4px; }
  .drag-ghost { position: fixed; left: 0; top: 0; z-index: 50; pointer-events: none; margin: -24px 0 0 -32px; filter: drop-shadow(0 10px 8px rgba(0, 0, 0, .25)); }
  .drag-ghost svg { width: 64px; height: 40px; overflow: visible; }

  /* panels */
  .panel { position: absolute; z-index: 5; border-radius: 22px; padding: 22px 24px; display: grid; gap: 10px; }
  .panel h2 { margin: 0; font-family: Fraunces, Georgia, serif; font-weight: 500; font-size: 1.8rem; }
  .panel p { margin: 0; line-height: 1.5; }
  .adopt { right: 26px; top: 50%; transform: translateY(-50%); width: min(400px, calc(100% - 32px)); }
  .adopt[hidden], .goodbye[hidden] { display: none; }
  .eggs { display: grid; grid-template-columns: repeat(6, 1fr); gap: 6px; }
  .egg-pick { display: grid; justify-items: center; gap: 3px; border: 1px solid transparent; border-radius: 14px; background: transparent; padding: 6px 2px; cursor: pointer;
    font: 700 .66rem Nunito, sans-serif; color: var(--glass-muted); transition: background .2s, transform .2s; }
  .egg-pick svg { width: 38px; height: 46px; overflow: visible; transition: transform .3s cubic-bezier(.2, 1.4, .4, 1); }
  .egg-pick:hover svg { transform: rotate(-6deg); }
  .egg-pick.on { background: color-mix(in srgb, var(--glass-text) 8%, transparent); border-color: var(--glass-line); color: var(--glass-text); }
  .egg-pick.on svg { transform: scale(1.12); }
  .field-label { font-weight: 800; font-size: .8rem; letter-spacing: .06em; text-transform: uppercase; color: var(--glass-muted); margin-top: 4px; }
  .field-input { font: 600 1.05rem Nunito, sans-serif; padding: 10px 12px; border-radius: 12px; border: 1px solid var(--glass-line); background: rgba(255, 255, 255, .6); color: #2a2420; }
  .t-night .field-input { background: rgba(255, 255, 255, .08); color: var(--glass-text); }
  .chips { display: flex; flex-wrap: wrap; gap: 6px; }
