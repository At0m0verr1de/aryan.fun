---
import { GOOGLE } from './icons.js';

interface Props {
  crumb?: string;
}
const { crumb } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---
<header class="site-head">
  <div class="site-head-inner">
    <a class="wordmark" href={base}><span class="dot"></span><span data-wordmark>made by aryan</span></a>

    <!-- Groups mode: which group you're looking at, switchable from any page. -->
    <div class="group-switch" data-groups hidden>
      <button class="gs-btn" data-gs="toggle" type="button" aria-haspopup="menu" aria-expanded="false" aria-label="Switch group">
        <span data-gs-icon>＋</span><span class="gs-name" data-gs-name>Groups</span><span class="gs-caret" aria-hidden="true">▾</span>
      </button>
      <div class="menu gs-menu" role="menu" data-gs-menu hidden>
        <div class="gs-list" data-gs-list></div>
        <hr data-gs-sep />
        <button role="menuitem" type="button" data-gs="invite">💌 <span>Invite people</span></button>
        <button role="menuitem" type="button" data-gs="new">＋ New group</button>
        <button role="menuitem" type="button" data-gs="join">🔑 Join with a code</button>
      </div>
    </div>

    {crumb && <span class="crumb"><span class="sep">/</span>{crumb}</span>}

    <div class="account" data-account data-state="loading">
      <button class="signin" data-auth="signin" type="button"><Fragment set:html={GOOGLE} />Sign in</button>

      <div class="profile">
        <button class="avatar-btn" data-auth="toggle" type="button" aria-haspopup="menu" aria-expanded="false" aria-label="Account menu">
          <span data-initial></span>
        </button>
        <div class="menu" role="menu" data-menu hidden>
          <div class="menu-id"><strong data-name></strong><span data-email></span></div>
          <a role="menuitem" href={base} data-home-link>Home</a>
          <button role="menuitem" type="button" data-auth="switch">Switch account</button>
          <hr />
          <div class="mode-row" data-mode-row hidden>
            <span>Mode</span>
            <button type="button" data-auth="mode" data-mode="couple"><span class="heart">♥</span> Us</button>
            <button type="button" data-auth="mode" data-mode="general">Groups</button>
          </div>
          <a role="menuitem" href={`${base}privacy/`}>Privacy</a>
          <a role="menuitem" href={`${base}terms/`}>Terms</a>
          <hr />
          <button role="menuitem" type="button" data-auth="signout" class="danger">Sign out</button>
        </div>
      </div>
    </div>
  </div>
</header>

<dialog class="gs-dialog" data-gs-dialog>
  <form method="dialog" data-gs-form>
    <h3 data-gs-title>New group</h3>
    <div data-gs-fields></div>
    <p class="gs-error" data-gs-error hidden></p>
    <div class="gs-actions">
      <button class="btn ghost" type="button" data-gs="cancel">Cancel</button>
      <button class="btn" type="submit" data-gs-submit>Create</button>
    </div>
  </form>
</dialog>

<script>
  import './header.js';
</script>

<style is:global>
  .site-head {
    position: sticky; top: 0; z-index: 20;
    background: color-mix(in srgb, var(--bg) 72%, transparent);
    backdrop-filter: blur(14px) saturate(140%); -webkit-backdrop-filter: blur(14px) saturate(140%);
    border-bottom: 1px solid color-mix(in srgb, var(--line) 55%, transparent);
  }
  .site-head-inner { max-width: 980px; margin: 0 auto; padding: 0 16px; height: 60px; display: flex; align-items: center; gap: 10px; }
  .wordmark { display: inline-flex; align-items: center; gap: 9px; color: var(--text); text-decoration: none;
    font-family: Fredoka, sans-serif; font-weight: 600; font-size: 1.12rem; letter-spacing: .2px; white-space: nowrap; }
  .wordmark .dot { width: 10px; height: 10px; border-radius: 50%; background: linear-gradient(135deg, var(--pink), var(--blue)); }
  :root[data-mode="couple"] .wordmark .dot { background: var(--heart); clip-path: path('M5 9 C-3 3.5 1.5-1.5 5 2.2 C8.5-1.5 13 3.5 5 9Z'); border-radius: 0; }
  .crumb { color: var(--muted); font-weight: 700; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .crumb .sep { color: var(--faint); margin: 0 8px 0 2px; }

  .account { margin-left: auto; position: relative; display: flex; align-items: center; min-width: 36px; min-height: 36px; justify-content: flex-end; }
  .account .signin, .account .profile { display: none; }
  .account[data-state="out"] .signin { display: inline-flex; }
  .account[data-state="in"] .profile { display: block; }
  .signin { align-items: center; gap: 8px; padding: 7px 14px 7px 11px; border-radius: 999px; cursor: pointer;
    background: var(--text); color: #1a1424; border: none; font-weight: 800; font-size: .92rem; }
  .signin:hover { background: #fff; }

  .avatar-btn { width: 36px; height: 36px; border-radius: 50%; padding: 0; border: 2px solid transparent; cursor: pointer; overflow: hidden;
    background: linear-gradient(135deg, var(--pink), var(--blue)); color: #1a1424; font-weight: 800; display: grid; place-items: center; transition: border-color .15s; }
  .avatar-btn.emoji { background: var(--surface-2); font-size: 1.2rem; }
  .avatar-btn:hover, .avatar-btn[aria-expanded="true"] { border-color: var(--text); }

  .menu { position: absolute; right: 0; top: calc(100% + 10px); min-width: 230px; padding: 6px; border-radius: 14px;
    background: var(--surface); border: 1px solid var(--line); box-shadow: 0 18px 40px rgba(0, 0, 0, .45); }
  .menu-id { padding: 10px 10px 8px; display: flex; flex-direction: column; min-width: 0; }
  .menu-id strong { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .menu-id span { color: var(--muted); font-size: .85rem; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .menu a, .menu button { display: block; width: 100%; text-align: left; padding: 8px 10px; border-radius: 9px; border: none; background: none;
    color: var(--text); text-decoration: none; font-weight: 600; font-size: .94rem; cursor: pointer; }
  .menu a:hover, .menu button:hover { background: var(--surface-2); }
  .menu .danger { color: var(--danger); }
  .menu hr { border: none; border-top: 1px solid var(--line); margin: 6px 4px; }
  .mode-row { display: flex; align-items: center; gap: 4px; margin: 2px 0 6px; padding: 6px 6px 6px 10px; border-radius: 10px; background: var(--surface-2);
    color: var(--faint); font-size: .8rem; font-weight: 700; }
  .mode-row span:first-child { margin-right: auto; }
  .menu .mode-row button { width: auto; padding: 4px 10px; font-size: .82rem; border-radius: 999px; }
  .menu .mode-row button[aria-pressed="true"] { background: var(--surface); color: var(--text); box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--heart) 55%, var(--line)); }
  .group-switch { position: relative; min-width: 0; }
  .gs-btn { display: inline-flex; align-items: center; gap: 6px; max-width: 220px; padding: 5px 10px 5px 8px; border-radius: 999px; cursor: pointer;
    background: var(--surface); border: 1px solid var(--line); color: var(--text); font-weight: 800; font-size: .88rem; transition: border-color .15s; }
  .gs-btn:hover, .gs-btn[aria-expanded="true"] { border-color: var(--lilac); }
  .gs-name { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; min-width: 0; }
  .gs-caret { color: var(--faint); font-size: .75rem; }
  .menu.gs-menu { left: 0; right: auto; min-width: 250px; }
  .gs-list { display: grid; gap: 2px; max-height: 50vh; overflow-y: auto; }
  .menu .gs-list button { display: flex; align-items: center; gap: 10px; }
  .gs-list .gs-count { margin-left: auto; color: var(--faint); font-size: .8rem; font-weight: 700; }
  .menu .gs-list button[aria-current="true"] { background: var(--surface-2); box-shadow: inset 3px 0 0 var(--lilac); }
  .gs-dialog { border: 1px solid var(--line); border-radius: var(--radius); background: var(--surface); color: var(--text); padding: 22px; width: min(440px, calc(100% - 32px)); }
  .gs-dialog::backdrop { background: rgba(8, 6, 14, .7); }
  .gs-dialog h3 { margin: 0 0 6px; font-family: Fredoka, sans-serif; }
  .gs-dialog label { display: flex; flex-direction: column; gap: 5px; margin-top: 12px; color: var(--muted); font-size: .8rem; font-weight: 800; text-transform: uppercase; letter-spacing: .5px; }
  .gs-dialog .field-input { text-transform: none; letter-spacing: normal; font-size: 1rem; }
  .gs-dialog .field-input.code { text-transform: uppercase; letter-spacing: 4px; text-align: center; font-size: 1.3rem; font-weight: 800; }
  .gs-pick { display: grid; grid-template-columns: repeat(auto-fill, minmax(36px, 1fr)); gap: 4px; }
  .gs-pick button { height: 36px; font-size: 1.2rem; border-radius: 10px; border: 1px solid transparent; background: var(--surface-2); cursor: pointer; padding: 0; }
  .gs-pick button.on { border-color: var(--lilac); background: color-mix(in srgb, var(--lilac) 18%, var(--surface-2)); }
  .gs-error { color: var(--danger); font-weight: 700; font-size: .9rem; margin: 12px 0 0; }
  .gs-actions { display: flex; justify-content: flex-end; gap: 8px; margin-top: 18px; }
  @media (max-width: 480px) {
    .crumb { display: none; }
    .gs-btn { max-width: 150px; }
    .wordmark { font-size: 1rem; }
  }
</style>
