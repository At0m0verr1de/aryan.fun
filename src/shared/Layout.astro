---
import './theme.css';
import SiteHeader from './SiteHeader.astro';

interface Props {
  title: string;
  description?: string;
  crumb?: string; // shown after the wordmark, e.g. the toy name
}
const { title, description = 'Small, silly, playable things.', crumb } = Astro.props;
const favicon = `data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 64 64'><defs><linearGradient id='g' x1='0' y1='0' x2='1' y2='1'><stop offset='0' stop-color='%23ff8fc4'/><stop offset='1' stop-color='%237cc4ff'/></linearGradient></defs><rect width='64' height='64' rx='18' fill='url(%23g)'/><text x='32' y='45' font-size='38' text-anchor='middle' font-family='Arial,sans-serif' font-weight='700' fill='%2314111b'>a</text></svg>`;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <link rel="icon" href={favicon} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Fredoka:wght@500;600;700&family=Nunito:wght@400;600;700;800&display=swap" rel="stylesheet" />
    <!-- Last mode, applied before paint so the couple theme doesn't flash (src/shared/space.js keeps it current). -->
    <!-- The old workers.dev address and www both move to rups.fun, keeping the path so invite links still work. -->
    <script is:inline>if (['madebyaryan.aryanbakshi2021.workers.dev', 'www.rups.fun'].includes(location.hostname)) location.replace(`https://rups.fun${location.pathname}${location.search}${location.hash}`);</script>
    <script is:inline>try { document.documentElement.dataset.mode = localStorage.getItem('mba:mode:last') || 'general'; } catch {}</script>
  </head>
  <body>
    <SiteHeader crumb={crumb} />
    <div class="wrap">
      <slot />
    </div>
  </body>
</html>
